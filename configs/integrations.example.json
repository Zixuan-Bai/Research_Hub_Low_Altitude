{
  "openai": {
    "api_key_env": "OPENAI_API_KEY",
    "reading_model_env": "OPENAI_READING_MODEL",
    "default_reading_model": "gpt-5.5"
  },
  "kimi": {
    "api_key_env": "MOONSHOT_API_KEY",
    "fallback_api_key_env": "KIMI_API_KEY",
    "base_url_env": "MOONSHOT_BASE_URL",
    "fallback_base_url_env": "KIMI_BASE_URL",
    "default_base_url": "https://api.moonshot.cn/v1",
    "reading_model_env": "KIMI_READING_MODEL",
    "default_reading_model": "kimi-k2.6"
  },
  "notion": {
    "enabled": false,
    "token_env": "NOTION_TOKEN",
    "workspace_role": "visual_review_surface",
    "databases": {
      "paper_inbox": "",
      "download_queue": "",
      "reading_queue": "",
      "evidence_map_board": "",
      "route_review_board": ""
    }
  },
  "zotero": {
    "enabled": false,
    "api_key_env": "ZOTERO_API_KEY",
    "user_or_group_id": "",
    "library_type": "user",
    "role": "pdf_and_library_manager"
  },
  "semantic_scholar": {
    "api_key_env": "SEMANTIC_SCHOLAR_API_KEY",
    "required": false
  }
}
